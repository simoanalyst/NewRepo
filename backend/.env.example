# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://jewelry_user:jewelry_pass@localhost:5432/kenyan_jewelry?schema=public

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-too-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# --- M-Pesa Daraja API (Safaricom) ---
# Get these from https://developer.safaricom.co.ke after creating an app
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
MPESA_ACCOUNT_REFERENCE=KenyanJewelry
MPESA_TRANSACTION_DESC=Jewelry Purchase

# --- Airtel Money (optional) ---
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENV=sandbox

# --- Card Payments (e.g. Pesapal / Flutterwave / Stripe) ---
CARD_PROVIDER=pesapal
CARD_PROVIDER_KEY=
CARD_PROVIDER_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kenyan Jewelry <no-reply@kenyanjewelry.co.ke>"

# --- WhatsApp Business (Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_NUMBER=+254700000000

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
